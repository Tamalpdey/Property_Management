ROOT_DOMAIN=maplepropertyservices.ca
MAIN_DOMAIN=www.maplepropertyservices.ca
API_DOMAIN=api.maplepropertyservices.ca
APP_DOMAIN=app.maplepropertyservices.ca
ADMIN_DOMAIN=admin.maplepropertyservices.ca
WORKER_DOMAIN=worker.maplepropertyservices.ca
WS_DOMAIN=ws.maplepropertyservices.ca

DOCKER_PLATFORM=linux/amd64
COMPOSE_PROJECT_NAME=maple-property-services
IMAGE_PREFIX=maple-property-services
IMAGE_TAG=latest

# External PostgreSQL, for example Supabase.
DB_URL=jdbc:postgresql://db.<supabase-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=change-me
LORNE_BOOTSTRAP_ENABLED=false
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
LORNE_REFRESH_TOKEN_WORKER_EXPIRATION_DAYS=30
LORNE_REFRESH_TOKEN_TENANT_EXPIRATION_DAYS=7
LORNE_REFRESH_TOKEN_ADMIN_EXPIRATION_DAYS=1
LORNE_ALLOWED_ORIGINS=https://maplepropertyservices.ca,https://www.maplepropertyservices.ca,https://api.maplepropertyservices.ca,https://app.maplepropertyservices.ca,https://admin.maplepropertyservices.ca,https://worker.maplepropertyservices.ca,https://ws.maplepropertyservices.ca
LORNE_TENANT_PORTAL_URL=https://app.maplepropertyservices.ca
LORNE_ADMIN_PORTAL_URL=https://admin.maplepropertyservices.ca
LORNE_WORKER_APP_URL=https://worker.maplepropertyservices.ca

LORNE_WORKER_AUTO_CLOCK_OUT_ENABLED=true
LORNE_WORKER_AUTO_CLOCK_OUT_GRACE_MINUTES=60
LORNE_WORKER_AUTO_CLOCK_OUT_MAX_OPEN_HOURS=16
LORNE_WORKER_AUTO_CLOCK_OUT_INITIAL_DELAY_MS=120000
LORNE_WORKER_AUTO_CLOCK_OUT_FIXED_DELAY_MS=300000

# Google Routes API travel estimates. Defaults include highways/toll roads.
LORNE_TRAVEL_ESTIMATES_ENABLED=false
LORNE_TRAVEL_ESTIMATES_PROVIDER=GOOGLE_MAPS
GOOGLE_MAPS_API_KEY=replace-with-google-routes-api-key
GOOGLE_MAPS_ROUTES_ENDPOINT=https://routes.googleapis.com/directions/v2:computeRoutes
LORNE_TRAVEL_ESTIMATES_ROUTING_PREFERENCE=TRAFFIC_AWARE_OPTIMAL
LORNE_TRAVEL_ESTIMATES_TRAFFIC_MODEL=BEST_GUESS
LORNE_TRAVEL_ESTIMATES_AVOID_TOLLS=false
LORNE_TRAVEL_ESTIMATES_AVOID_HIGHWAYS=false
LORNE_TRAVEL_ESTIMATES_AVOID_FERRIES=false
LORNE_TRAVEL_ESTIMATES_TIMEOUT_MS=2500

HTTP_PORT=80
HTTPS_PORT=443
