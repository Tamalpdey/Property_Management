(security_headers) {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "0"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    Cross-Origin-Opener-Policy "same-origin"
    -Server
  }
  encode gzip zstd
}

(security_headers_admin) {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "0"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    -Server
  }
  encode gzip zstd
}

{$ROOT_DOMAIN}, maplepropertyservices.ca {
  import security_headers

  redir https://{$APP_DOMAIN}{uri} permanent
}

{$MAIN_DOMAIN}, www.maplepropertyservices.ca {
  import security_headers

  redir https://{$APP_DOMAIN}{uri} permanent
}

{$API_DOMAIN}, api.maplepropertyservices.ca {
  import security_headers

  handle {
    reverse_proxy lorne-modulith:8091
  }
}

{$APP_DOMAIN}, app.maplepropertyservices.ca {
  import security_headers

  @api path /api/v1/*
  handle @api {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    reverse_proxy tenant-portal:80
  }
}

{$ADMIN_DOMAIN}, admin.maplepropertyservices.ca {
  import security_headers_admin

  @api path /api/v1/*
  handle @api {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    reverse_proxy admin-portal:80
  }
}

{$WORKER_DOMAIN}, worker.maplepropertyservices.ca {
  import security_headers

  @api path /api/v1/*
  handle @api {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    reverse_proxy worker-app:80
  }
}

{$WS_DOMAIN}, ws.maplepropertyservices.ca {
  import security_headers

  @ws path /ws/* /api/v1/ws/*
  handle @ws {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    respond "Not found" 404
  }
}
