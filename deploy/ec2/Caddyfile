{
  on_demand_tls {
    ask http://lorne-modulith:8091/api/v1/public/tenant-domains/allow
  }
}

(security_headers) {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "0"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    Cross-Origin-Opener-Policy "same-origin"
    -Server
  }
  encode gzip zstd
}

(tenant_portal_routes) {
  @api path /api/v1/*
  handle @api {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    reverse_proxy tenant-portal:80
  }
}

(worker_portal_routes) {
  @api path /api/v1/*
  handle @api {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    reverse_proxy worker-app:80
  }
}

(security_headers_admin) {
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "0"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    -Server
  }
  encode gzip zstd
}

{$ROOT_DOMAIN}, maplepropertyservices.ca {
  import security_headers

  handle /login {
    redir https://{$APP_DOMAIN}/login 308
  }

  handle {
    root * /srv/maple-site
    try_files {path} /index.html
    file_server
  }
}

{$MAIN_DOMAIN}, www.maplepropertyservices.ca {
  import security_headers

  handle /login {
    redir https://{$APP_DOMAIN}/login 308
  }

  handle {
    root * /srv/maple-site
    try_files {path} /index.html
    file_server
  }
}

platinumservices.ca, www.platinumservices.ca {
  import security_headers

  @api path /api/v1/*
  handle @api {
    reverse_proxy lorne-modulith:8091
  }

  handle /contact {
    redir /#contact 308
  }

  handle {
    root * /srv/platinum-site
    try_files {path} /index.html
    file_server
  }
}

{$API_DOMAIN}, api.maplepropertyservices.ca {
  import security_headers

  handle {
    reverse_proxy lorne-modulith:8091
  }
}

{$APP_DOMAIN}, app.maplepropertyservices.ca {
  import security_headers
  import tenant_portal_routes
}

{$ADMIN_DOMAIN}, admin.maplepropertyservices.ca {
  import security_headers_admin

  @api path /api/v1/*
  handle @api {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    reverse_proxy admin-portal:80
  }
}

{$WORKER_DOMAIN}, worker.maplepropertyservices.ca {
  import security_headers
  import worker_portal_routes
}

https:// {
  tls {
    on_demand
  }
  import security_headers

  @tenant_app host *.app.{$ROOT_DOMAIN}
  handle @tenant_app {
    @tenant_app_api path /api/v1/*
    handle @tenant_app_api {
      reverse_proxy lorne-modulith:8091
    }
    handle {
      reverse_proxy tenant-portal:80
    }
  }

  @tenant_worker host *.worker.{$ROOT_DOMAIN}
  handle @tenant_worker {
    @tenant_worker_api path /api/v1/*
    handle @tenant_worker_api {
      reverse_proxy lorne-modulith:8091
    }
    handle {
      reverse_proxy worker-app:80
    }
  }

  handle {
    respond "Not found" 404
  }
}

{$WS_DOMAIN}, ws.maplepropertyservices.ca {
  import security_headers

  @ws path /ws/* /api/v1/ws/*
  handle @ws {
    reverse_proxy lorne-modulith:8091
  }

  handle {
    respond "Not found" 404
  }
}
