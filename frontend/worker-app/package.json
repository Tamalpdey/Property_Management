    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lorne/contracts": "file:../packages/lorne-contracts",
    "@primeng/themes": "^21.0.4",
    "primeicons": "^7.0.0",
